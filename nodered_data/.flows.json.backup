    {
        "id": "a63fe8d7dabbb0ac",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "status return",
        "func": "const SECRET = 'demo-token-change-me';\nif (msg.req.query.token !== SECRET) {\n    msg.statusCode = 403;\n    msg.payload = 'Forbidden';\n    return msg;\n}\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Access-Control-Allow-Origin': 'http://yknam.duckdns.org/grafana'\n};\n\nconst sim = flow.get('simDay');\nconst view = flow.get('simView');\nif (sim && sim.active && view) {\n    msg.payload = view;\n} else {\n    msg.payload = flow.get('simStatus') || { stage: 'NORMAL', equipment: {} };\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 60,
