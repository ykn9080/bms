    {
        "id": "731e6cd64915ec88",
        "type": "inject",
        "z": "f08fa4dd96ae2cb6",
        "name": "5초틱",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 110,
        "y": 260,
        "wires": [
            [
                "bfa90ff1aba3eb58"
            ]
        ]
    },
    {
        "id": "795bc7f9003e3407",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "재실인원생성",
        "func": "// 1. 상태 로드 (40실, 0명 초기화)\nconst sim = flow.get('simDay');\nconst KEY = (sim && sim.active) ? 'roomsDemo' : 'rooms';\nlet rooms = flow.get(KEY);\nif (!rooms) {\n    rooms = {};\n    for (let f = 1; f <= 10; f++) {\n        for (const r of ['A', 'B', 'C', 'D']) {\n            rooms[`${f}F_${r}`] = 0;\n        }\n    }\n}\n\n// 2. 시각 결정: 데모 중이면 가상 시각, 아니면 실제 시각\n\n\nconst demo = !!(sim && sim.active);\nlet minuteOfDay;\nif (demo) {\n    minuteOfDay = sim.simMinute;\n} else {\n    const now = new Date();\n    minuteOfDay = now.getHours() * 60 + now.getMinutes();\n}\n\n// 3. 점유율 앵커 (수용 400명 기준)\nconst CAPACITY = 400;\nconst DEMO_ANCHORS = [\n    { m: 16 * 60, pct: 0.80 },\n    { m: 17 * 60, pct: 0.70 },\n    { m: 18 * 60, pct: 0.30 },\n    { m: 19 * 60, pct: 0.10 },\n    { m: 20 * 60, pct: 0.05 },\n    { m: 21 * 60, pct: 0.03 },\n    { m: 22 * 60, pct: 0.01 }\n];\nconst NORMAL_ANCHORS = [\n    { m: 0,       pct: 0.05 },\n    { m: 7 * 60,  pct: 0.05 },\n    { m: 9 * 60,  pct: 0.90 },\n    { m: 13 * 60, pct: 0.70 },\n    { m: 17 * 60, pct: 0.70 },\n    { m: 19 * 60, pct: 0.05 },\n    { m: 24 * 60, pct: 0.05 }\n];\nconst A = demo ? DEMO_ANCHORS : NORMAL_ANCHORS;\n\nfunction pctAt(m) {\n    if (m <= A[0].m) return A[0].pct;\n    for (let i = 0; i < A.length - 1; i++) {\n        const a = A[i], b = A[i + 1];\n        if (m >= a.m && m <= b.m) {\n            return a.pct + (b.pct - a.pct) * (m - a.m) / (b.m - a.m);\n        }\n    }\n    return A[A.length - 1].pct;\n}\n\nconst targetTotal = Math.round(pctAt(minuteOfDay) * CAPACITY);\n\n// 4. 목표 인원에 맞춰 실별 무작위 증감 (실당 0~10명)\nlet currentTotal = Object.values(rooms).reduce((a, b) => a + b, 0);\nconst gap = targetTotal - currentTotal;\nconst moves = Math.min(Math.abs(gap), 400);   // 틱당 최대 400명 이동\nconst dir = gap > 0 ? 1 : -1;\n\nconst keys = Object.keys(rooms);\nfor (let i = 0; i < moves; i++) {\n    const candidates = keys.filter(k => dir > 0 ? rooms[k] < 10 : rooms[k] > 0);\n    if (candidates.length === 0) break;\n    const key = candidates[Math.floor(Math.random() * candidates.length)];\n    rooms[key] += dir;\n    currentTotal += dir;\n}\n\n// 5. 상태 저장\nflow.set(KEY, rooms);\n// 6. 다음 노드로 전달\nmsg.rooms = rooms;\nmsg.totalPeople = currentTotal;\nmsg.targetPct = Math.round(pctAt(minuteOfDay) * 1000) / 10;\nmsg.minuteOfDay = minuteOfDay;\nmsg.demo = demo;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 260,
        "wires": [
            [
                "eef0ad4ad26739df"
            ]
        ]
    },
    {
        "id": "bfa90ff1aba3eb58",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "명령입력",
        "func": "// 버튼/HTTP 명령을 읽어 상태 명령으로 정리\nconst CMD_MAP = {\n    ANOMALY_TEMP: 'temp',\n    ANOMALY_TEMP_LOW: 'tempLow',\n    ANOMALY_HUMI: 'humi',\n    ANOMALY_CO2: 'co2'\n};\n\nlet raw;\nif (msg.req && msg.req.query && msg.req.query.action !== undefined) {\n    raw = msg.req.query.action;\n} else if (typeof msg.payload === 'string') {\n    raw = msg.payload;\n}\nconst cmd = (raw === undefined) ? 'TICK' : String(raw).trim().toUpperCase();\n\nlet s = flow.get('state') || {\n    anomaly: null, equipOn: false, detectTicks: 0, okTicks: 0,\n    alerted: false, recovered: false,\n    temp: 22.0, humi: 45.0, co2: 550, lux: 350, occupied: false\n};\n\nif (CMD_MAP[cmd] !== undefined) {\n    if (s.anomaly !== CMD_MAP[cmd]) {\n        s.anomaly = CMD_MAP[cmd];\n        s.equipOn = false;\n        s.detectTicks = 0;\n        s.okTicks = 0;\n        s.alerted = false;\n        s.recovered = false;\n    }\n} else if (cmd === 'RESET') {\n    s.anomaly = null;\n    s.equipOn = false;\n    s.detectTicks = 0;\n    s.okTicks = 0;\n    s.alerted = false;\n    s.recovered = false;\n    flow.set('simDay', { active: false });\n    flow.set('simView', null);\n} else if (cmd === 'OCCUPY_ON') {\n    s.occupied = true;\n} else if (cmd === 'OCCUPY_OFF') {\n    flow.set('simDay', {\n        active: true,\n        startMinute: 16 * 60,\n        endMinute: 22 * 60,\n        simMinute: 16 * 60,\n        stepMinute: 60,\n        ticks: 0\n    });\n} else if (cmd !== 'TICK') {\n    node.warn(`알 수 없는 명령: [${cmd}]`);\n}\n\nflow.set('state', s);\nmsg.state = s;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 260,
        "wires": [
            [
                "9b8ab7d8f3a6a281"
            ]
        ]
    },
    {
        "id": "9b8ab7d8f3a6a281",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "시나리오엔진",
        "func": "// ---------- 설정 (틱 = 5초) ----------\nconst SC = {\n    temp:    { sensor: 'temp', dir: 'high', detect: 28,   severe: 30,   ok: 24,  rise: 3.0,  fall: 3.0,  noise: 0.4, cap: 45.0 },\n    tempLow: { sensor: 'temp', dir: 'low',  detect: 18,   severe: 15,   ok: 20,  rise: 3.0,  fall: 3.0,  noise: 0.4, cap: 5.0  },\n    humi:    { sensor: 'humi', dir: 'high', detect: 60,   severe: 75,   ok: 55,  rise: 8.0,  fall: 11.5, noise: 0.8, cap: 100.0 },\n    co2:     { sensor: 'co2',  dir: 'high', detect: 1000, severe: 1300, ok: 900, rise: 250,  fall: 220,  noise: 20,  cap: 3000 }\n};\nconst ALERT_TICKS = 2;     // 기준 초과 2틱 연속 → 이상 표시 (약 10초)\nconst RUN_TICKS = 4;       // 기준 초과 3틱 연속 → 장비 기동 (약 15초)\nconst RECOVER_TICKS = 3;   // 정상 범위 3틱 연속 → 복귀 확정 (약 15초)\nconst NORMAL_TARGET = { temp: 22.0, humi: 45.0, co2: 500, co2Occupied: 650 };\n\nconst noise = (amp) => (Math.random() - 0.5) * amp;\nconst isBeyond = (L, x, lim) => (L.dir === 'high' ? x >= lim : x <= lim);\nconst isRecovered = (L, x) => (L.dir === 'high' ? x <= L.ok : x >= L.ok);\n\n// ---------- 상태 ----------\nconst s = flow.get('state') || msg.state;\ns.detectTicks = s.detectTicks || 0;\ns.okTicks = s.okTicks || 0;\ns.alerted = !!s.alerted;\ns.equipOn = !!s.equipOn;\n\n\n// 정상 센서: 목표값 주변 변동 (이상 센서 제외)\n// 이상 센서: 이상 방향으로 변화, 장비 가동 중에는 복귀 기준선 근처에서 정지\nfunction stepAnomaly(st) {\n    if (!st.anomaly) return;\n    const L = SC[st.anomaly];\n    const k = (L.dir === 'high') ? 1 : -1;\n\n    if (st.equipOn) {\n        st[L.sensor] -= k * L.fall + noise(L.noise);\n        // 복귀 기준선 0.5 안쪽에서 멈춤 → 3틱 확인 중 과냉각 방지\n        const floor = (L.dir === 'high') ? L.ok - 0.5 : L.ok + 0.5;\n        st[L.sensor] = (L.dir === 'high')\n            ? Math.max(st[L.sensor], floor)\n            : Math.min(st[L.sensor], floor);\n    } else {\n        st[L.sensor] += k * L.rise + noise(L.noise);\n        st[L.sensor] = (L.dir === 'high')\n            ? Math.min(st[L.sensor], L.cap)\n            : Math.max(st[L.sensor], L.cap);\n    }\n}\n// 정상 센서: 목표값 주변 변동 (이상 센서 제외)\nfunction stepNormal(st) {\n    const anomSensor = st.anomaly ? SC[st.anomaly].sensor : null;\n    if (anomSensor !== 'temp') st.temp += (NORMAL_TARGET.temp - st.temp) * 0.1 + noise(0.3);\n    if (anomSensor !== 'humi') st.humi += (NORMAL_TARGET.humi - st.humi) * 0.1 + noise(1.0);\n    if (anomSensor !== 'co2') {\n        const target = st.occupied ? NORMAL_TARGET.co2Occupied : NORMAL_TARGET.co2;\n        st.co2 += (target - st.co2) * 0.1 + noise(20);\n    }\n}\n\n// 판정: 연속 틱 카운트로 이상 표시, 장비 기동, 복귀를 결정\nfunction judgeScenario(st) {\n    if (!st.anomaly) return;                  // 가드를 가장 먼저\n    const L = SC[st.anomaly];\n    const v = st[L.sensor];\n    st.dbg = { v: v, before: st.detectTicks, beyond: isBeyond(L, v, L.detect) };\n\n    // 이하 기존 로직 그대로\n    if (!st.equipOn) {\n        if (isBeyond(L, v, L.detect)) {\n            st.detectTicks += 1;\n        } else {\n            st.detectTicks = 0;\n        }\n        if (st.detectTicks >= ALERT_TICKS) st.alerted = true;\n        if (st.detectTicks >= RUN_TICKS) st.equipOn = true;\n        if (isRecovered(L, v)) st.alerted = false;\n    } else if (isRecovered(L, v)) {\n        st.okTicks += 1;\n        if (st.okTicks >= RECOVER_TICKS) {\n            st.anomaly = null;\n            st.equipOn = false;\n            st.alerted = false;\n            st.detectTicks = 0;\n            st.okTicks = 0;\n            st.recovered = true;\n        }\n    } else {\n        st.okTicks = 0;\n    }\n}\n\n// 단계 계산\nfunction calcStage(st) {\n    if (!st.anomaly) return st.recovered ? 'RECOVERED' : 'NORMAL';\n    if (st.equipOn) return 'MITIGATING';\n    if (st.alerted) return 'DETECTED';   // 이상 표시 구간은 DETECTED로 고정\n    return 'NORMAL';\n}\n// 조도: 외부 일사량 + 실내 조명\nfunction stepLux(st) {\n    const now = new Date();\n    const hour = now.getHours() + now.getMinutes() / 60;\n    let outdoor = 0;\n    if (hour > 6 && hour < 19) outdoor = Math.sin(Math.PI * (hour - 6) / 13) * 1000;\n    outdoor = Math.max(0, outdoor + noise(60));\n    const lightOn = st.occupied && outdoor < 400;\n    const indoorTarget = outdoor * 0.3 + (lightOn ? 350 : 0);\n    st.lux += (indoorTarget - st.lux) * 0.3 + noise(5);\n    st.lux = Math.min(Math.max(st.lux, 0), 1000);\n    return { outdoor, lightOn };\n}\n\n// ---------- 한 틱 실행 ----------\ns.runs = (s.runs || 0) + 1;     // 함수가 매 틱 실행되는지 확인용\n\nstepAnomaly(s);\nstepNormal(s);\njudgeScenario(s);\nconst stage = calcStage(s);\nconst envInfo = stepLux(s);\n\nconst cur = { anomaly: s.anomaly, equipOn: s.equipOn, stage: stage };\n\nflow.set('state', s);\nmsg.state = s;\nmsg.shown = cur;\nmsg.envInfo = envInfo;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 320,
        "wires": [
            [
                "795bc7f9003e3407"
            ]
        ]
    },
    {
        "id": "5a6c84951376151d",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "출력생성",
        "func": "const sim = flow.get('simDay');\nif (sim && sim.active) {\n    // 라이팅 시연 중에는 InfluxDB/AWS 게시 생략 (시연 값은 flow에만)\n    return null;\n}\n\nconst s = msg.state;\nmsg.lux = msg.lux ?? s.lux;\nmsg.outdoor = msg.outdoor ?? 0;\nmsg.litCount = msg.litCount ?? 0;\nmsg.rooms = msg.rooms || {};\nconst shown = msg.shown;\n\n// 1. 장비 가동 상태 (직전 틱 판정 기준)\nconst equip = {\n    chiller: shown.anomaly === 'temp' && shown.equipOn,\n    heater: shown.anomaly === 'tempLow' && shown.equipOn,\n    humidifier: false,\n    dehumidifier: shown.anomaly === 'humi' && shown.equipOn,\n    ahu: shown.anomaly === 'co2' && shown.equipOn\n};\n\n// 2. 장비/환기 상태 문자열\nlet hvac = \"OFF\";\nif (s.temp > 28) hvac = \"COOL_ON\";\nelse if (s.temp < 18) hvac = \"HEAT_ON\";\nif (equip.chiller) hvac = \"COOL_ON\";\nif (equip.heater) hvac = \"HEAT_ON\";\n\nlet humiStatus = \"OFF\";\nif (s.humi < 40) humiStatus = \"HUMIDIFIER_ON\";\nelse if (s.humi > 60) humiStatus = \"DEHUMIDIFIER_ON\";\nif (equip.dehumidifier) humiStatus = \"DEHUMIDIFIER_ON\";\n\nlet vent = \"OFF\";\nif (s.co2 > 1000) vent = \"VENT_HIGH\";\nelse if (s.co2 > 800) vent = \"VENT_LOW\";\nif (equip.ahu) vent = \"AHU_FRESH_AIR\";\n\n\n// 4. 발행 payload 구성 (point 단위)\nconst ASSET = \"AS_FL19_NODERED_SEN_01\";\nconst ts = Date.now();\nconst P = (pid, value, unit, type) => ({ point_id: pid, value, unit, type });\n\nconst points = {\n    temperature: P(\"PT_FL19_NODERED_TEMP\", parseFloat(s.temp.toFixed(1)), \"°C\", \"temperature\"),\n    humidity:    P(\"PT_FL19_NODERED_HUMI\", Math.round(s.humi), \"%\", \"humidity\"),\n    co2:         P(\"PT_FL19_NODERED_CO2\", Math.floor(s.co2), \"ppm\", \"co2\"),\n    lux:         P(\"PT_FL19_NODERED_LUX\", msg.lux, \"lx\", \"lux\"),\n    outdoor_lux: P(\"PT_FL19_NODERED_OUTLUX\", msg.outdoor, \"lx\", \"outdoor_lux\"),\n    lit_rooms:   P(\"PT_FL19_NODERED_LITROOMS\", msg.litCount, \"rooms\", \"lit_rooms\"),\n    occupied:    P(\"PT_FL19_NODERED_OCC\", s.occupied ? 1 : 0, \"bool\", \"occupied\"),\n    \n};\n\n// 방별 재실 인원: 방 하나당 point 하나\nfor (const key of Object.keys(msg.rooms)) {\n    points[`room_${key}`] = P(`PT_FL19_OCC_${key}`, msg.rooms[key], \"person\", \"occupancy\");\n}\n\n// 문자열 상태 point\nconst status_points = {\n    hvac:     { point_id: \"PT_FL19_HVAC_STATUS\", value_str: hvac },\n    vent:     { point_id: \"PT_FL19_VENT_STATUS\", value_str: vent },\n    humidity: { point_id: \"PT_FL19_HUMI_STATUS\", value_str: humiStatus },\n    light:    { point_id: \"PT_FL19_LIGHT_STATUS\", value_str: msg.litCount > 0 ? \"LIGHT_ON\" : \"OFF\" },\n    system:   { point_id: \"PT_FL19_SYS_STATE\", value_str: shown.equipOn ? \"RECOVERING\" : (shown.anomaly ? \"ANOMALY\" : \"NORMAL\") }\n};\n// 출력생성 함수, payload 구성 직전\nflow.set('seq', (flow.get('seq') || 0) + 1);\n\nmsg.payload = {\n    seq: flow.get('seq'),\n    timestamp: ts,\n    asset_id: ASSET,\n    points: points,\n    status_points: status_points\n};\nmsg.topic = \"bms/FL19/\" + ASSET + \"/telemetry\";\nmsg.equip = equip;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 200,
        "wires": [
            [
                "acd1e7db4426a58e",
                "dc49e0f535d2853b",
                "498d8b0f85a6fa8d"
            ]
        ]
    },
    {
        "id": "acd1e7db4426a58e",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "상태저장",
        "func": "const st = msg.state;\nconst shown = msg.shown;\n\nflow.set('simStatus', {\n    timestamp: msg.payload.timestamp,\n    mode: 'REAL',\n    stage: shown.stage,\n    anomaly_type: shown.anomaly,\n    equipment: msg.equip,\n    temperature: Number(st.temp.toFixed(1)),\n    humidity: Math.round(st.humi),\n    co2: Math.floor(st.co2),\n    lux: msg.lux,\n    lit_rooms: msg.litCount,\n    occupied: st.occupied,\n    occupancy: msg.rooms,\ndebug: {\n    runs: st.runs,\n    dbg: st.dbg,\n    anomaly: st.anomaly,\n    equipOn: st.equipOn,\n    detectTicks: st.detectTicks,\n    alerted: st.alerted,\n    okTicks: st.okTicks\n}\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 300,
        "wires": [
            []
        ]
    },
    {
        "id": "eef0ad4ad26739df",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "Lux계산",
        "func": "// ===== Lux계산: 실별 조도 → 건물 평균 =====\nconst LUX_OCCUPIED = 400;   // 재실 실 조도\nconst LUX_EMPTY = 0;     // 빈 실 조도\n\nconst rooms = msg.rooms;\nconst keys = Object.keys(rooms);\nconst totalRooms = keys.length;   // 40\n\nconst lightState = {};\nlet litCount = 0;\nlet sumLux = 0;\n\nfor (const key of keys) {\n    const occupied = rooms[key] > 0;   // 1명 이상이면 재실\n    lightState[key] = occupied;\n    if (occupied) litCount++;\n    sumLux += occupied ? LUX_OCCUPIED : LUX_EMPTY;\n}\n\n// 건물 평균 조도 = 전체 실 조도 합 ÷ 전체 실 수 (빈 실 0 포함)\nconst avgLux = totalRooms > 0 ? sumLux / totalRooms : 0;\n\nmsg.lightState = lightState;\nmsg.lux = Math.round(avgLux * 10) / 10;   // 소수 첫째 자리\nmsg.litCount = litCount;\nconst hour = new Date().getHours() + new Date().getMinutes() / 60;\nmsg.outdoor = Math.round(hour > 6 && hour < 19 ? Math.sin(Math.PI * (hour - 6) / 13) * 1000 : 0);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 320,
        "wires": [
            [
                "5a6c84951376151d",
                "4e25c4b6fccf60dc"
            ]
        ]
    },
    {
        "id": "4e25c4b6fccf60dc",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "Light Simulate",
        "func": "const sim = flow.get('simDay');\nif (sim && sim.active) {\n    sim.ticks++;\n    if (sim.simMinute >= sim.endMinute) {\n        sim.active = false;          // 22:00 상태를 한 번 표시한 뒤 종료\n    } else {\n        sim.simMinute += sim.stepMinute;\n    }\n    flow.set('simDay', sim);\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 340,
        "wires": [
            [
                "ab5c1d5afb6b3848"
            ]
        ]
    },
    {
        "id": "ab5c1d5afb6b3848",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "Light Summary",
        "func": "const BASELINE_LUX = 400;\nconst lux = msg.lux ?? 0;\nconst savingsPct = Number(((BASELINE_LUX - lux) / BASELINE_LUX * 100).toFixed(1));\n\nconst sim = flow.get('simDay');\nif (msg.demo && sim) {\n    const m = msg.minuteOfDay;\n    const hh = String(Math.floor(m / 60)).padStart(2, '0');\n    const mm = String(m % 60).padStart(2, '0');\n    const progress = (m - sim.startMinute) / (sim.endMinute - sim.startMinute) * 100;\n\n    flow.set('simView', {\n        mode: 'DEMO',\n        time: `${hh}:${mm}`,\n        people: msg.totalPeople ?? 0,\n        outdoor_lux: msg.outdoor ?? 0,\n        lux: lux,\n        savings_pct: savingsPct,\n        occupancy: msg.rooms,\n        progress_pct: Math.min(100, Math.max(0, Math.round(progress)))\n    });\n} else {\n    // 데모가 끝나면 화면 상태를 일반 모드로 되돌림\n    flow.set('simView', null);\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 340,
        "wires": [
            []
        ]
    },
    {
        "id": "14ef87559cd519ee",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "BMS_Data_Mapping",
        "func": "if (typeof msg.payload === 'string') msg.payload = JSON.parse(msg.payload);\nif (!msg.payload || typeof msg.payload !== 'object') return null;\n\nconst d = msg.payload;\nconst asset_id = String(d.asset_id || \"UNKNOWN\");\nconst ts = Number(d.timestamp) || Date.now();\n\n// 태그 값 정리: 공백, 쉼표, 등호 제거\nconst clean = (v) => String(v).replace(/[ ,=]/g, \"_\");\n\nconst recs = [];\nconst skipped = [];\n\n// 숫자 point → bms_numeric (value: float)\nfor (const p of Object.values(d.points || {})) {\n    const v = Number(p.value);\n    if (!Number.isFinite(v)) { skipped.push(p.point_id); continue; }\n    recs.push({\n        measurement: \"bms_numeric\",\n        timestamp: ts,\n        tags: {\n            point_id: clean(p.point_id),\n            asset_id: clean(asset_id),\n            sensor_type: clean(p.type)\n        },\n        fields: { value: v }\n    });\n}\n\n// 상태 point → bms_status (value_str: string)\nfor (const p of Object.values(d.status_points || {})) {\n    if (p.value_str === undefined || p.value_str === null) { skipped.push(p.point_id); continue; }\n    recs.push({\n        measurement: \"bms_status\",\n        timestamp: ts,\n        tags: {\n            point_id: clean(p.point_id),\n            asset_id: clean(asset_id),\n            sensor_type: \"status\"\n        },\n        fields: { value_str: String(p.value_str) }\n    });\n}\n\nif (skipped.length) node.warn(\"제외된 point: \" + skipped.join(\", \"));\nif (recs.length === 0) return null;\n\nmsg.payload = recs;\nreturn msg;",
