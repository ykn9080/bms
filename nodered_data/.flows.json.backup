            ]
        ]
    },
    {
        "id": "9b127178e390cb7b",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "Postgres 삽입문",
        "func": "const p = msg.payload;\n\n// 유효성 검사: 객체가 아니거나 timestamp가 없으면 저장하지 않음\nif (!p || typeof p !== 'object' || !p.timestamp) return null;\n\nmsg.topic = `INSERT INTO sensor_data\n    (timestamp, temperature, humidity, co2, lux, occupied, power_consumption, quality_score)\n    VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`;\n\nmsg.payload = [\n    new Date(Number(p.timestamp)).toISOString(),\n    p.temperature ?? null,\n    p.humidity ?? null,\n    p.co2 ?? null,\n    p.lux ?? null,\n    p.occupied === true || p.occupied === 'true',\n    p.power_consumption ?? null,\n    p.quality_score ?? null\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 120,
        "wires": [
            [
                "9c910a8fe644c786"
            ]
        ]
    },
    {
        "id": "9c910a8fe644c786",
        "type": "postgresql",
        "z": "f08fa4dd96ae2cb6",
        "name": "Postgres실행",
        "query": "",
        "postgreSQLConfig": "postgres-config-fixed",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 1170,
        "y": 180,
        "wires": [
            []
        ]
    },
    {
        "id": "dc49e0f535d2853b",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "이상 데이터 판별",
        "func": "// ===== 기준값 (생성기와 동일하게 유지) =====\nconst LIMIT = {\n    TEMP_LOW: 18,         // 이하 → 비정상 (HEAT_ON 대상)\n    TEMP_HIGH: 27,        // 이상 → 비정상 (COOL_ON 대상)\n    HUMI_LOW: 40,         // 미만 → 비정상\n    HUMI_HIGH: 60,        // 초과 → 비정상\n    CO2_WARN: 800,        // 초과 → 주의\n    CO2_ABNORMAL: 1000    // 초과 → 비정상\n};\nconst RATE_LIMIT = 4.5;   // 온도 변화율 허용치 (5초 기준)\n\n// ===== 1건 평가 =====\nfunction evaluate(p) {\n    const issues = [];\n    const skipRate = p.disable_rate_check ?? false;\n\n    // 온도\n    const lastTemp = context.get('lastTemp') ?? p.temperature;\n    context.set('lastTemp', p.temperature);\n\n    if (p.temperature <= LIMIT.TEMP_LOW) {\n        issues.push({ label: 'Temperature low (HEAT_ON)', penalty: 35 });\n    } else if (p.temperature >= LIMIT.TEMP_HIGH) {\n        issues.push({ label: 'Temperature high (COOL_ON)', penalty: 35 });\n    } else if (!skipRate && Math.abs(p.temperature - lastTemp) > RATE_LIMIT) {\n        issues.push({ label: 'Abnormal temp change', penalty: 35 });\n    }\n\n    // 습도\n    if (p.humidity < LIMIT.HUMI_LOW || p.humidity > LIMIT.HUMI_HIGH) {\n        issues.push({ label: 'Humidity out of range (40~60)', penalty: 35 });\n    }\n\n    // CO2 (800 초과 주의, 1000 초과 비정상)\n    if (p.co2 > LIMIT.CO2_ABNORMAL) {\n        issues.push({ label: 'CO2 abnormal (>1000)', penalty: 35 });\n    } else if (p.co2 > LIMIT.CO2_WARN) {\n        issues.push({ label: 'CO2 warning (>800)', penalty: 15 });\n    }\n\n    const totalPenalty = issues.reduce((sum, i) => sum + i.penalty, 0);\n    return {\n        score: Math.max(0, 100 - totalPenalty),\n        issues: issues.map(i => i.label)\n    };\n}\n\n// ===== 평가 후 비정상만 insert 메시지로 변환 =====\nconst records = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\nconst insertMsgs = [];\n\nrecords.forEach(p => {\n    if (!p || typeof p !== 'object') return;\n\n    const r = evaluate(p);\n    if (r.score >= 100) return;   // 정상 → 제외\n\n    insertMsgs.push({\n        topic: `INSERT INTO abnormal_data\n                (event_time, temperature, humidity, co2, power_consumption,\n                 quality_score, issues, system_state, anomaly_type)\n                VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)`,\n        payload: [\n            new Date(p.timestamp).toISOString(),\n            p.temperature,\n            p.humidity,\n            p.co2,\n            p.power_consumption,\n            r.score,\n            r.issues.join(', '),\n            p.system_state ?? null,\n            p.anomaly_type ?? null\n        ]\n    });\n});\n\n// 비정상이 없으면 아무것도 보내지 않음\nif (insertMsgs.length === 0) return null;\nreturn insertMsgs;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 180,
        "wires": [
            [
                "9b127178e390cb7b"
            ]
        ]
    },
