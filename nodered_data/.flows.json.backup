    {
        "id": "bcbe3a2ee81db21c",
        "type": "influxdb in",
        "z": "f08fa4dd96ae2cb6",
        "influxdb": "13821ed682a03952",
        "name": "influxdb_read",
        "query": "from(bucket: \"node_red_bucket\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"sensor_data\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature\" or \n                       r[\"_field\"] == \"humidity\" or \n                       r[\"_field\"] == \"power_consumption\" or \n                       r[\"_field\"] == \"co2\" or \n                       r[\"_field\"] == \"lux\" )\n  |> aggregateWindow(every: 5s, fn: mean, createEmpty: false)\n  |> sort(columns: [\"_time\"], desc: false) \n  // [보완] 시간 오름차순 정렬을 확정하여 루프 끝에 '최신값'이 오도록 보장",
        "rawOutput": false,
        "precision": "",
        "retentionPolicy": "",
        "org": "yknam",
        "x": 380,
        "y": 660,
        "wires": [
            [
                "8b1d645d46cdca0b"
            ]
        ]
    },
    {
        "id": "8b1d645d46cdca0b",
        "type": "function",
        "z": "f08fa4dd96ae2cb6",
        "name": "dashboard용 data",
        "func": "const chartPoints = [];\nconst latestGaugeData = {};\n\n// 1. InfluxDB 데이터 안전 검증 및 루프 순회\nif (Array.isArray(msg.payload)) {\n    msg.payload.forEach(item => {\n        const fieldName = item._field;\n        let value = item._value;\n        if (value === null || value === undefined) return;\n\n        // 타임스탬프 밀리초 파싱 보장\n        let timeMillis = 0;\n        if (typeof item._time === 'number') {\n            timeMillis = item._time;\n        } else if (typeof item._time === 'string') {\n            timeMillis = new Date(item._time).getTime();\n        } else if (item._time instanceof Date) {\n            timeMillis = item._time.getTime();\n        }\n\n        if (!timeMillis || isNaN(timeMillis)) {\n            timeMillis = Date.now();\n        }\n\n        // 2. 전력 소비량 차트 데이터 적재 (차트 노드 설정인 category: topic에 대응)\n        if (fieldName === \"power_consumption\") {\n            chartPoints.push({\n                x: timeMillis,             // xAxisProperty: \"x\"와 매칭\n                y: Number(value.toFixed(1)) // yAxisProperty: \"y\"와 매칭\n            });\n        } else {\n            // 3. 환경 센서 게이지 데이터 적재\n            let roundedValue;\n            if (fieldName === \"temperature\") {\n                roundedValue = Number(value.toFixed(1)); \n            } else if (fieldName === \"humidity\" || fieldName === \"co2\" || fieldName === \"lux\") {\n                roundedValue = Math.round(value); \n            } else {\n                roundedValue = value;\n            }\n\n            latestGaugeData[fieldName] = roundedValue;\n        }\n    });\n}\n\n// --- 1번 출력 (위쪽 포트): Dashboard 2.0 ui-chart(category: topic) 전용 포맷 ---\n// 차트 노드 설정이 \"category\": \"topic\" 이므로, msg.topic에 시리즈명을 넣고 payload에 순수 [{x, y}] 배열을 보냅니다.\nconst msgLine = {\n    topic: \"Power Consumption\", // 차트 범례에 표시될 이름\n    action: \"replace\",\n    payload: chartPoints        // 순수 [{x: 타임스탬프, y: 값}] 구조의 플랫 배열\n};\n\n// --- 2번 출력 (아래쪽 포트): 게이지 노드용 스트림 분기 패킷 ---\nconst msgGauges = Object.keys(latestGaugeData).map(key => {\n    return {\n        topic: key,\n        payload: latestGaugeData[key]\n    };\n});\n\nreturn [msgLine, msgGauges];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 660,
        "wires": [
            [
                "cb3886ba48823456"
            ],
            [
                "77e93b016d60328d"
            ]
        ]
    },
    {
        "id": "77e93b016d60328d",
        "type": "switch",
        "z": "f08fa4dd96ae2cb6",
        "name": "",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "humidity",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "temperature",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "lux",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "co2",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 4,
        "x": 770,
        "y": 660,
        "wires": [
            [
                "ab59bc3166310e3c"
            ],
            [
                "fd0eb5d556fa7278"
            ],
