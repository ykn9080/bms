# PostgreSQL 설정 (구분자를 =로 변경)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# InfluxDB 설정 (docker-compose 변수명과 일치시킴)
INFLUXDB_ADMIN_USER=
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORGANIZATION=
INFLUXDB_BUCKET_NAME=node-red-bucket

# Grafana 설정
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
#GF_ANONYMOUS_ON=true
#ec2용
GF_ANONYMOUS_ON=false

# pgAdmin 설정
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
