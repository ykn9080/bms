events {}

http {
    server {
        listen 80;
        server_name yknam.duckdns.org www.yknam.duckdns.org;

        # HTTP 요청을 HTTPS로 강제 리디렉션
          return 301 https://$host$request_uri;
    }
    server {
        listen 443 ssl;
        server_name yknam.duckdns.org www.yknam.duckdns.org;
        # 컨테이너 내부로 연결될 인증서 경로
        ssl_certificate /etc/letsencrypt/live/yknam.duckdns.org/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/yknam.duckdns.org/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        location = /grafana {
            return 301 /grafana/;
        }
        # --- 1. 그라파나 라우팅 ---
        location /grafana/ {
            # localhost:3000 대신 서비스 이름 사용
            proxy_pass http://grafana:3000;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 웹소켓 설정
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
        }

        # --- 2. 노드레드 라우팅 ---
        location /nodered/ {
            # localhost:1880 대신 서비스 이름 사용
            proxy_pass http://node-red:1880/;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 웹소켓 설정
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
