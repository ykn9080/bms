          "showMiniMap": false
        },
        "content": "<div id=\"occ-demo\" style=\"background:#181b1f;color:#e0e0e0;font-family:sans-serif;font-size:12px;padding:4px;\">\n  <div id=\"demo-bar\" style=\"display:none;padding:4px 6px;background:#22252b;margin-bottom:4px;\"></div>\n  <table id=\"occ-table\" style=\"width:100%;border-collapse:collapse;\"></table>\n</div>\n<style>\n  #occ-table th, #occ-table td { border:1px solid #333; padding:2px 4px; text-align:center; }\n  #occ-table td.on { background:#f8de37b8; color:#000; }\n  #occ-table td.off { background:#1d251c; color:#666; }\n</style>\n\n<script>\n(() => {\n  const OCC_TOKEN = 'demo-token-change-me';\n  const OCC_API = 'http://localhost:1880';\n\n  function renderOccupancy(occ) {\n    const cols = ['A', 'B', 'C', 'D'];\n    let html = '<tr><th>floor</th>' + cols.map(c => `<th>${c}</th>`).join('') + '</tr>';\n    for (let f = 10; f >= 1; f--) {\n      html += `<tr><td>${f}F</td>`;\n      for (const c of cols) {\n        const n = occ[`${f}F_${c}`] ?? 0;\n        html += `<td class=\"${n > 0 ? 'on' : 'off'}\">${n}</td>`;\n      }\n      html += '</tr>';\n    }\n    const total = Object.values(occ).reduce((a, b) => a + b, 0);\n    html += `<tr><td>Total</td><td colspan=\"4\">${total}</td></tr>`;\n    document.getElementById('occ-table').innerHTML = html;\n  }\n\n  async function occPoll() {\n    try {\n      const r = await fetch(`${OCC_API}/grafana-status?token=${OCC_TOKEN}`, { cache: 'no-store' });\n      const s = await r.json();\n\n      if (s.occupancy) renderOccupancy(s.occupancy);\n\n      const bar = document.getElementById('demo-bar');\n      if (s.mode === 'DEMO') {\n        bar.style.display = 'block';\n        bar.textContent =\n          `[07:00~21:00 시연] 진행 ${s.progress_pct}% | ${s.time} | 인원 ${s.people}명 | ` +\n          `외부 ${s.outdoor_lux}lx | 실내 ${s.lux}lx | 절감 ${s.savings_pct}%`;\n      } else {\n        bar.style.display = 'none';\n      }\n    } catch (e) { /* 연결 실패 시 기존 표 유지 */ }\n  }\n\n  occPoll();\n  setInterval(occPoll, 2000);\n})();\n</script>",
        "mode": "html"
      },
