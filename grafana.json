        "content": "<div id=\"root\">\n  <div id=\"collapsed\" class=\"collapsed show\">\n    <button class=\"sim-btn\" onclick=\"window.toggleOpen(true)\">\n      <svg class=\"sim-icon\" viewBox=\"0 0 512 512\" aria-hidden=\"true\">\n        <line x1=\"40\" y1=\"90\" x2=\"472\" y2=\"90\" stroke=\"#2d3a4e\" stroke-width=\"30\" stroke-linecap=\"round\"/>\n        <circle cx=\"340\" cy=\"90\" r=\"70\" fill=\"#2d3a4e\"/>\n        <circle cx=\"340\" cy=\"90\" r=\"42\" fill=\"#0099c6\"/>\n        <line x1=\"40\" y1=\"256\" x2=\"472\" y2=\"256\" stroke=\"#2d3a4e\" stroke-width=\"30\" stroke-linecap=\"round\"/>\n        <circle cx=\"172\" cy=\"256\" r=\"70\" fill=\"#2d3a4e\"/>\n        <circle cx=\"172\" cy=\"256\" r=\"42\" fill=\"#f5b400\"/>\n        <line x1=\"40\" y1=\"420\" x2=\"472\" y2=\"420\" stroke=\"#2d3a4e\" stroke-width=\"30\" stroke-linecap=\"round\"/>\n        <circle cx=\"340\" cy=\"420\" r=\"70\" fill=\"#2d3a4e\"/>\n        <circle cx=\"340\" cy=\"420\" r=\"42\" fill=\"#c8104e\"/>\n      </svg>\n      <span>Simulation</span>\n    </button>\n  </div>\n\n  <div class=\"wrap\" id=\"wrap\">\n    <div class=\"panel left\">\n      <div class=\"ptitle\">Simulate</div>\n      <div class=\"btns\">\n        <button class=\"btn\" onclick=\"window.send('ANOMALY_TEMP',this)\">Hot</button>\n        <button class=\"btn\" onclick=\"window.send('ANOMALY_TEMP_LOW',this)\">Cold</button>\n        <button class=\"btn\" onclick=\"window.send('ANOMALY_HUMI',this)\">Humid</button>\n        <button class=\"btn\" onclick=\"window.send('ANOMALY_CO2',this)\">CO2</button>\n        <button class=\"btn\" onclick=\"window.send('OCCUPY_OFF',this)\">Lighting</button>\n        <button class=\"btn\" onclick=\"window.send('RESET',this)\">Reset</button>\n      </div>\n    </div>\n\n    <div class=\"panel mid\">\n      <div class=\"ptitle\">Status</div>\n      <div class=\"status-grid\">\n        <div id=\"status-normal\">\n          <div class=\"lamps\">\n            <div class=\"lampbox\" data-lamp=\"normal\" style=\"--c:#4caf50\"><div class=\"lamp\"></div><span>정상</span></div>\n            <div class=\"lampbox\" data-lamp=\"alert\" style=\"--c:#f44336\"><div class=\"lamp\"></div><span>이상</span></div>\n            <div class=\"lampbox\" data-lamp=\"run\" style=\"--c:#ff9800\"><div class=\"siren\">🚨</div><span>장비작동</span></div>\n          </div>\n          <div class=\"msgText msg\">데이터 대기 중...</div>\n          <div id=\"conn\" style=\"font-size:11px;color:#90a4ae;text-align:right;\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"panel right\">\n      <div class=\"ptitle\">Equipment</div>\n      <div class=\"devs\">\n        <div class=\"dev\" id=\"d-chiller\"><span class=\"ico\">❄️</span><span class=\"nm\">Chiller</span></div>\n        <div class=\"dev\" id=\"d-heater\"><span class=\"ico\">🔥</span><span class=\"nm\">Heater</span></div>\n        <div class=\"dev\" id=\"d-humidifier\"><span class=\"ico\">💧</span><span class=\"nm\">Humidifier</span></div>\n        <div class=\"dev\" id=\"d-dehumidifier\"><span class=\"ico\">🌫️</span><span class=\"nm\">Dehumidifier</span></div>\n        <div class=\"dev\" id=\"d-ahu\"><span class=\"ico\">🌬️</span><span class=\"nm\">AHU</span></div>\n      </div>\n    </div>\n\n    <div class=\"close-col\">\n      <button class=\"close-btn\" onclick=\"window.toggleOpen(false)\" title=\"끄기\" aria-label=\"끄기\">\n        <svg viewBox=\"0 0 512 512\" aria-hidden=\"true\">\n          <path d=\"M152 44h208a108 108 0 0 1 108 108v208a108 108 0 0 1-108 108H152A108 108 0 0 1 44 360V152A108 108 0 0 1 152 44z\"\n                fill=\"none\" stroke=\"#fff\" stroke-width=\"42\" stroke-linejoin=\"round\"/>\n          <line x1=\"190\" y1=\"190\" x2=\"322\" y2=\"322\" stroke=\"#fff\" stroke-width=\"42\" stroke-linecap=\"round\"/>\n          <line x1=\"322\" y1=\"190\" x2=\"190\" y2=\"322\" stroke=\"#fff\" stroke-width=\"42\" stroke-linecap=\"round\"/>\n        </svg>\n      </button>\n    </div>\n  </div>\n</div>\n\n<style>\n  #root { width:100%; height:15vh; min-height:0; box-sizing:border-box; padding:4px; background:transparent;\n          color:#e0e0e0; font-family:sans-serif; font-size:16px; display:flex; overflow:hidden; }\n  .collapsed { display:none; width:100%; height:100%; box-sizing:border-box; align-items:center; justify-content:center; }\n  .collapsed.show { display:flex; }\n  .sim-btn { display:inline-flex; align-items:center; gap:6px; height:30px; padding:0 12px;\n             border:none; border-radius:5px; background:#1e88e5; color:#fff; font-size:16px; font-weight:bold;\n             cursor:pointer; box-shadow:0 2px 4px rgba(0,0,0,.3); transition:all .2s; }\n  .sim-btn:hover { filter:brightness(1.2); }\n  .sim-icon { width:20px; height:20px; flex:0 0 auto; }\n  .wrap { display:none; width:100%; height:100%; gap:6px; padding:0; box-sizing:border-box; }\n  .wrap.open { display:flex; }\n  .panel { flex:1 1 0; min-width:0; height:100%; background:#22252b; border-radius:5px; padding:4px 6px;\n           box-sizing:border-box; display:flex; flex-direction:column; gap:4px; overflow:hidden; }\n  .left  { flex-grow:1.1; }\n  .mid   { flex-grow:1.1; }\n  .right { flex-grow:1.4; }\n  .ptitle { font-size:14px; font-weight:bold; color:#90a4ae; border-left:3px solid #546e7a; padding-left:5px; line-height:15px; }\n  .close-col { flex:0 0 28px; height:100%; box-sizing:border-box; display:flex; align-items:flex-start; justify-content:center; padding-top:4px; }\n  .close-btn { border:none; background:transparent; padding:0; margin:0; width:20px; height:20px;\n               cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }\n  .close-btn svg { width:20px; height:20px; display:block; }\n  .status-grid { flex:1; min-height:0; display:grid; grid-template-rows:repeat(2, minmax(0, 1fr)); gap:14px; align-items:stretch; }\n  #status-normal { display:block; }\n  .btns { flex:1; min-height:0; display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(2,1fr); gap:4px; }\n  .btn { border:none; color:#fff; background:#1e88e5; font-weight:bold; font-size:14px;\n         border-radius:4px; cursor:pointer; box-shadow:0 1px 3px rgba(0,0,0,.3); transition:all .2s;\n         display:flex; align-items:center; justify-content:center; padding:0; }\n  .btn:hover { filter:brightness(1.2); }\n  .btn:disabled { opacity:.5; }\n  .lamps { display:flex; justify-content:space-around; align-items:center; }\n  .lampbox { display:flex; align-items:center; gap:4px; font-size:16px; line-height:17px; opacity:.3; transition:all .3s; }\n  .lampbox.on { opacity:1; }\n  .lamp { width:20px; height:20px; border-radius:50%; background:#3a3f48; }\n  .lampbox.on .lamp { background:var(--c); box-shadow:0 0 6px var(--c); }\n  .lampbox[data-lamp=\"alert\"].on .lamp { animation:blink 1s infinite; }\n  .siren { font-size:16px; line-height:17px; filter:grayscale(1); }\n  .lampbox[data-lamp=\"run\"].on .siren { filter:none; animation:blink .6s infinite; }\n  @keyframes blink { 50% { opacity:.3; } }\n  .msg { text-align:center; padding:1px 4px; border-radius:4px; background:#181b1f; margin-top:20px;\n         font-weight:bold; font-size:14px; line-height:17px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .devs { flex:1; min-height:0; display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(2,1fr); gap:4px; }\n  .dev { box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:3px; padding:0 3px;\n         border:1px solid #333; border-radius:6px; background:#1f2228; color:#777; transition:all .4s; min-width:0; }\n  .dev .ico { font-size:20px; line-height:1; }\n  .dev .nm  { font-size:14px; font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .dev.on { border-color:#42a5f5; color:#fff; box-shadow:0 0 6px rgba(66,165,245,.6); }\n  .dev.on .ico { animation:pulse 1.2s ease-in-out infinite; }\n  @keyframes pulse { 50% { transform:scale(1.2); } }\n</style>\n\n<script>\n(() => {\n  const TOKEN = 'demo-token-change-me';\n  const API = 'https://yknam.duckdns.org/nodered';\n\n  function toggleOpen(open) {\n    document.getElementById('collapsed').classList.toggle('show', !open);\n    document.getElementById('wrap').classList.toggle('open', open);\n  }\n\n  const LAMP = { NORMAL:'normal', RECOVERED:'normal',\n                 ANOMALY:'alert', DETECTED:'alert', SEVERE:'alert',\n                 MITIGATING:'run' };\n  const TXT = {\n    NORMAL: '정상 운전 중',\n    RECOVERED: '정상화 완료 - 정상 운전 복귀',\n    ANOMALY: '이상 발생 - 수치 상승 중',\n    DETECTED: '이상 감지 - 임계값 초과',\n    SEVERE: '심각 - 장비 자동 기동 대기',\n    MITIGATING: '장비 작동 중 - 자동 조치'\n  };\n  const ANOM = { temp:'온도', tempLow:'저온', humi:'습도', co2:'CO2' };\n  const DEV = { chiller:'d-chiller', heater:'d-heater', humidifier:'d-humidifier',\n                dehumidifier:'d-dehumidifier', ahu:'d-ahu' };\n\n  function setMsg(text) {\n    document.querySelectorAll('.msgText').forEach(el => el.textContent = text);\n  }\n\n    function showNormal(s) {\n    const kind = LAMP[s.stage] || 'normal';\n    document.querySelectorAll('[data-lamp]').forEach(el => {\n      el.classList.toggle('on', el.dataset.lamp === kind);\n    });\n    let text = TXT[s.stage] || '';\n    if (s.anomaly_type) text += ` (${ANOM[s.anomaly_type] || s.anomaly_type})`;\n    const msgEl = document.querySelector('#status-normal .msgText');\n    if (msgEl) msgEl.textContent = text;\n    const eq = s.equipment || {};\n    for (const k in DEV) {\n      const el = document.getElementById(DEV[k]);\n      if (el) el.classList.toggle('on', !!eq[k]);\n    }\n  }\nasync function send(action, btn) {\n    btn.disabled = true;\n    document.getElementById('conn').textContent = `명령 전송됨: ${action}`;\n    try {\n      const r = await fetch(`${API}/grafana-trigger?action=${encodeURIComponent(action)}&token=${TOKEN}`,\n                            { cache: 'no-store' });\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n    } catch (e) {\n      document.getElementById('conn').textContent = '전송 실패: ' + e.message;\n    } finally {\n      btn.disabled = false;\n    }\n  }\n    let failCount = 0;\n  let polling = false;\n\n  async function poll() {\n    if (polling) return;\n    polling = true;\n    try {\n      const r = await fetch(`${API}/grafana-status?token=${TOKEN}`, { cache: 'no-store' });\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n      const s = await r.json();\n      failCount = 0;\n      document.getElementById('conn').textContent = '';\n      try {\n        showNormal(s);\n      } catch (e) {\n        console.error('[status render]', e, s);\n      }\n    } catch (e) {\n      if (e.name === 'AbortError') return;\n      console.error('[status fetch]', e);\n      if (++failCount >= 2) document.getElementById('conn').textContent = 'Node-RED 연결 끊김';\n    } finally {\n      polling = false;\n    }\n  }\n  window.toggleOpen = toggleOpen;\n  window.send = send;\n\n  poll();\n  setInterval(poll, 2000);\n})();\n</script>",
