          "showMiniMap": false
        },
        "content": "<div id=\"sim-clock\" style=\"background:#181b1f;color:#e0e0e0;font-family:sans-serif;align-items:center;padding:10px;box-sizing:border-box;height:100%;\">\n  <svg viewBox=\"-60 -60 120 120\" width=\"130\" height=\"130\" style=\"flex:0 0 auto;\">\n    <circle r=\"54\" fill=\"#22252b\" stroke=\"#546e7a\" stroke-width=\"3\"/>\n    <g id=\"tick-marks\"></g>\n    <line id=\"hand-hour\"   x1=\"0\" y1=\"0\" x2=\"0\" y2=\"-30\" stroke=\"#e0e0e0\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    <line id=\"hand-minute\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"-44\" stroke=\"#90a4ae\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <circle r=\"3\" fill=\"#42a5f5\"/>\n  </svg>\n  <div style=\"font-size:13px;line-height:20px;margin:10px 0 0 10px;\">\n    <div id=\"sim-time\" style=\"display:none;font-size:22px;font-weight:bold;color:#fff;\">--:--</div>\n    <div>재실자수 <b id=\"sim-people\" style=\"color:#fff;\">0</b> / 전체400</div>\n    <div>Lux <b id=\"sim-lux\" style=\"color:#fff;\">0</b></div>\n    <div id=\"sim-badge\" style=\"font-size:16px;color:red;display:none;\">Simulation 중...</div>\n  </div>\n</div>\n\n<script>\n(() => {\n  const CLK_TOKEN = 'demo-token-change-me';\n  const CLK_API = 'https://yknam.duckdns.org/nodered';\n  const $ = id => document.getElementById(id);\n\n  // 12개 눈금\n  const ticks = $('tick-marks');\n  for (let i = 0; i < 12; i++) {\n    const a = i * Math.PI / 6;\n    const x1 = Math.sin(a) * 46, y1 = -Math.cos(a) * 46;\n    const x2 = Math.sin(a) * 52, y2 = -Math.cos(a) * 52;\n    ticks.insertAdjacentHTML('beforeend',\n      `<line x1=\"${x1}\" y1=\"${y1}\" x2=\"${x2}\" y2=\"${y2}\" stroke=\"#90a4ae\" stroke-width=\"2\"/>`);\n  }\n\n  function setHands(hhmm) {\n    const [h, m] = hhmm.split(':').map(Number);\n    const hourDeg = ((h % 12) + m / 60) * 30;   // 시침: 시간 + 분 보정\n    const minDeg  = m * 6;                       // 분침\n    $('hand-hour').setAttribute('transform', `rotate(${hourDeg})`);\n    $('hand-minute').setAttribute('transform', `rotate(${minDeg})`);\n  }\n\n  async function clkPoll() {\n    try {\n      const r = await fetch(`${CLK_API}/grafana-status?token=${CLK_TOKEN}`, { cache: 'no-store' });\n      const s = await r.json();\n      const isDemo = s.mode === 'DEMO';\n\n      if (isDemo && s.time) {\n        setHands(s.time);\n      } else {\n        const now = new Date();\n        setHands(`${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`);\n      }\n\n      if ($('sim-time')) {\n        $('sim-time').textContent = isDemo ? s.time : '';\n        $('sim-time').style.display = isDemo ? 'block' : 'none';\n      }\n      if ($('sim-people')) {\n        $('sim-people').textContent = s.people ?? Object.values(s.occupancy || {}).reduce((a, b) => a + b, 0);\n      }\n      if ($('sim-lux')) {\n        $('sim-lux').textContent = Math.round(s.lux ?? 0);\n      }\n      if ($('sim-badge')) {\n        $('sim-badge').style.display = isDemo ? 'block' : 'none';\n      }\n    } catch (e) { /* 연결 실패 시 마지막 상태 유지 */ }\n  }\n\n  clkPoll();\n  setInterval(clkPoll, 2000);\n})();\n</script>",
        "mode": "html"
      },
