        "content": "<div id=\"lux-gauge\" style=\"font-family:sans-serif;color:#e0e0e0;background:#181b1f;padding:6px;box-sizing:border-box;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;\">\n  <svg viewBox=\"0 0 200 120\" width=\"100%\" style=\"max-height:70%;\">\n    <path d=\"M20 110 A80 80 0 0 1 180 110\" fill=\"none\" stroke=\"#2a2e35\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n    <path id=\"lux-arc\" d=\"M20 110 A80 80 0 0 1 180 110\" fill=\"none\" stroke=\"#4caf50\" stroke-width=\"16\" stroke-linecap=\"round\"\n          stroke-dasharray=\"0 999\" pathLength=\"100\"/>\n  </svg>\n  <div id=\"lux-value\" style=\"font-size:36px;font-weight:bold;color:#4caf50;line-height:1;\">0</div>\n  <div style=\"font-size:12px;color:#90a4ae;\">lux (0 ~ 1000)</div>\n</div>\n\n<script>\n(() => {\n  const LUX_TOKEN = 'demo-token-change-me';\n  const LUX_API = 'https://yknam.duckdns.org/nodered';\n  const LUX_MAX = 1000;\n\n  function luxColor(v) {\n    if (v >= 800) return '#f44336';\n    if (v >= 600) return '#ffc107';\n    return '#4caf50';\n  }\n\n  async function luxPoll() {\n    try {\n      const r = await fetch(`${LUX_API}/grafana-status?token=${LUX_TOKEN}`, { cache: 'no-store' });\n      const s = await r.json();\n      const v = Math.max(0, Math.min(LUX_MAX, Math.round(s.lux ?? 0)));\n      const color = luxColor(v);\n      document.getElementById('lux-arc').setAttribute('stroke-dasharray', `${(v / LUX_MAX) * 100} 999`);\n      document.getElementById('lux-arc').setAttribute('stroke', color);\n      const el = document.getElementById('lux-value');\n      el.textContent = v;\n      el.style.color = color;\n    } catch (e) { /* 연결 실패 시 마지막 값 유지 */ }\n  }\n\n  luxPoll();\n  setInterval(luxPoll, 2000);\n})();\n</script>",
